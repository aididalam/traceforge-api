{
  "name": "@traceforge/api",
  "version": "0.17.0",
  "description": "TraceForge tenant-scoped HTTP API over the indexed MySQL read model",
  "main": "index.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/server.ts",
    "test:acceptance": "node --test test/acceptance.test.mjs",
    "api:migrate": "tsx src/api-migrate.ts",
    "auth:issue": "tsx src/issue-token.ts",
    "auth:list": "tsx src/list-tokens.ts",
    "auth:revoke": "tsx src/revoke-token.ts",
    "provenance:validate": "npm run provenance:validate:generic",
    "provenance:validate:generic": "node scripts/validate-generic-provenance.mjs test/fixtures/synthetic-generic-proof.json",
    "verify:provenance-schema": "node scripts/verify-generic-provenance-validator.mjs",
    "verify:write-journal-readiness": "node scripts/verify-write-journal-readiness.mjs",
    "verify:operational-readiness": "npm run typecheck && npm run test:acceptance && npm run provenance:validate && npm run verify:provenance-schema",
    "build": "tsc",
    "start": "node dist/server.js",
    "verify:production-build": "npm run build && node --check dist/server.js",
    "verify:mysql-backup-restore": "node scripts/verify-mysql-backup-restore.mjs",
    "verify:deployment-readiness": "npm run verify:operational-readiness && npm run verify:production-build && npm run verify:mysql-backup-restore && npm run verify:security-hardening && npm run verify:token-expiry && npm run verify:public-discovery && npm run verify:public-tracking && npm run verify:public-presentation && npm run verify:public-short-links && npm run verify:operator-dashboard",
    "verify:security-hardening": "node scripts/verify-security-hardening.mjs",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "verify:token-expiry": "node scripts/verify-token-expiry.mjs",
    "public:publish": "tsx src/set-public-entity.ts --publish",
    "public:unpublish": "tsx src/set-public-entity.ts --unpublish",
    "verify:public-discovery": "node scripts/verify-public-discovery.mjs",
    "test:public-discovery": "node scripts/test-public-discovery.mjs",
    "public:tracking-id": "tsx src/issue-public-tracking-id.ts",
    "verify:public-tracking": "node scripts/verify-public-tracking.mjs",
    "test:public-tracking": "node scripts/test-public-tracking.mjs",
    "public:details": "tsx src/set-public-details.ts",
    "verify:public-presentation": "node scripts/verify-public-presentation.mjs",
    "test:public-presentation": "node scripts/test-public-presentation.mjs",
    "public:short-link": "tsx src/issue-public-short-link.ts",
    "verify:public-short-links": "node scripts/verify-public-short-links.mjs",
    "test:public-short-links": "node scripts/test-public-short-links.mjs",
    "operator:invite": "tsx src/invite-operator.ts",
    "verify:operator-dashboard": "node scripts/verify-operator-dashboard.mjs",
    "test:operator-dashboard": "node scripts/test-operator-dashboard.mjs",
    "test:direct-claim": "node scripts/test-direct-claim-integration.mjs",
    "public:sync": "tsx src/sync-business-publications.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^6.1.1",
    "dotenv": "^18.0.5",
    "fastify": "^5.12.5",
    "mysql2": "^3.24.5",
    "viem": "^2.57.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "type": "module"
}
